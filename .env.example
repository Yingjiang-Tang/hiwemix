# ============================================================
# HIWE Formula Search — 环境变量模板
# 复制此文件为 .env.local 并填入实际值
# ============================================================

# JWT 密钥（生产环境务必修改为随机强密钥）
JWT_SECRET=your-random-secret-here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SECRET_KEY is server-only, used by getSupabaseAdmin()
SUPABASE_SECRET_KEY=your-service-role-key

# 站点 URL（生产域名）。邮件链接（注册确认 / 密码重置）的 redirectTo 必须与
# Supabase Dashboard 中的 Site URL 同源，否则 Supabase 会丢弃路径。
# 不设置时 fallback 到 window.location.origin（仅本地开发可用）。
# NEXT_PUBLIC_SITE_URL=https://hiwemix.com
